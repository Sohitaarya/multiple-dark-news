# LiteSpeed / Apache 200 OK SPA Rewrite for Hostinger & MultipleDarkNews Tools
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Keep physical files intact (sitemap.xml, robots.txt, assets, images)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Force 200 OK for all clean tool URLs (e.g. /pdf-compressor, /study-timetable-maker, /portfolio)
RewriteRule ^ index.html [L]
</IfModule>
