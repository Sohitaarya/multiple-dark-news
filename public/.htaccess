# LiteSpeed / Apache Auto-Sync Rewrite Rules for MultipleDarkNews Tools
# Automatically routes sitemap.xml and robots.txt to dynamic fetchers and handles SPA Routing

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Route sitemap.xml to dynamic XML/PHP generator
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Route robots.txt to dynamic TXT/PHP generator
RewriteRule ^robots\.txt$ robots.php [L]

# SPA Fallback: route clean tool, category, and portfolio paths to index.html if file/dir does not exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
</IfModule>
