# LiteSpeed / Apache Auto-Proxy & SPA 200 OK Rules for Hostinger
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Route sitemap.xml to physical file
RewriteRule ^sitemap\.xml$ sitemap.xml [L]

# Route robots.txt to physical file
RewriteRule ^robots\.txt$ robots.txt [L]

# Keep physical files intact
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all clean tool, category, and portfolio URLs to index.php with HTTP 200 OK for Googlebot
RewriteRule ^ index.php [L]
</IfModule>
