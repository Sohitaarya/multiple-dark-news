# LiteSpeed / Apache Auto-Sync Rewrite Rules for MultipleDarkNews Tools
# Automatically routes sitemap.xml and robots.txt to dynamic fetchers

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Route sitemap.xml to dynamic PHP fetcher
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Route robots.txt to dynamic PHP fetcher
RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>
